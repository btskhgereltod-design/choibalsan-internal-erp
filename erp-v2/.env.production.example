NODE_ENV=production
POSTGRES_DB=overva
POSTGRES_USER=overva
APP_DATABASE_USER=overva_app
JWT_ISSUER=overva-production
JWT_AUDIENCE=overva-production-web
CORS_ORIGINS=https://overva.com,https://www.overva.com,https://app.overva.com,https://admin.overva.com,https://auth.overva.com
ACME_EMAIL=admin@overva.com
BACKUP_INTERVAL_SECONDS=86400
MIGRATION_LOCK_TIMEOUT_MS=15000
MIGRATION_STATEMENT_TIMEOUT_MS=300000
MONITOR_INTERVAL_SECONDS=60
WEBHOOK_WORKER_INTERVAL_MS=30000
OVERVA_BACKUP_DIR=./backups-production
AI_ENABLED=false
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# OVERVA Connect remains unavailable until these OAuth registrations and secrets are configured.
CONNECTOR_CALLBACK_BASE_URL=https://api.overva.com
CONNECTOR_APP_URL=https://app.overva.com
# CONNECTOR_ENCRYPTION_KEY_FILE=/run/secrets/connector_encryption_key
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=/run/secrets/google_oauth_client_secret
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET_FILE=/run/secrets/github_oauth_client_secret

# Market auth providers are enabled only after provider registration and secret mounting are complete.
MARKET_APP_URL=https://overva.com
MARKET_EMAIL_ENABLED=false
# MARKET_EMAIL_ENDPOINT=https://mail-provider.example/send
# MARKET_EMAIL_FROM=no-reply@overva.com
# MARKET_EMAIL_TOKEN_FILE=/run/secrets/market_email_token
MARKET_GOOGLE_OIDC_ENABLED=false
# MARKET_GOOGLE_OIDC_CLIENT_ID=
# Client secret is mounted by docker-compose.production.yml from secrets/market_google_oidc_client_secret.
MARKET_SMS_ENABLED=false
# MARKET_SMS_ENDPOINT=https://sms-provider.example/send
# MARKET_SMS_SENDER=OVERVA
# MARKET_SMS_TOKEN_FILE=/run/secrets/market_sms_token
# MARKET_PHONE_FINGERPRINT_KEY_FILE=/run/secrets/market_phone_fingerprint_key
# MARKET_GOOGLE_OIDC_CALLBACK_URL=https://api.overva.com/api/market/auth/google/callback
