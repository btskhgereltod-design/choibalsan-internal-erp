{
  "name": "overva-api",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant modular API for the OVERVA platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "bootstrap": "node scripts/bootstrap.js",
    "test:integration": "node -e \"process.env.RUN_INTEGRATION='1'; require('./scripts/integration-test')\"",
    "test:business": "node -e \"process.env.RUN_BUSINESS_INTEGRATION='1'; require('./scripts/business-modules-test')\"",
    "test:finance": "node -e \"process.env.RUN_FINANCE_INTEGRATION='1'; require('./scripts/finance-integration-test')\"",
    "simulate:device": "node scripts/device-simulator.js",
    "test:operations": "node -e \"process.env.RUN_OPERATIONS_INTEGRATION='1'; require('./scripts/operations-integration-test')\"",
    "test:work-material": "node -e \"process.env.RUN_WORK_ORDER_MATERIAL_INTEGRATION='1'; require('./scripts/work-order-material-integration-test')\"",
    "test:work-assignment": "node -e \"process.env.RUN_WORK_ORDER_ASSIGNMENT_INTEGRATION='1'; require('./scripts/work-order-assignment-integration-test')\"",
    "test:work-workflow-notifications": "node -e \"process.env.RUN_WORK_ORDER_WORKFLOW_NOTIFICATION_INTEGRATION='1'; require('./scripts/work-order-workflow-notification-integration-test')\"",
    "test:automation-idempotency": "node -e \"process.env.RUN_AUTOMATION_IDEMPOTENCY_INTEGRATION='1'; require('./scripts/automation-idempotency-integration-test')\"",
    "test:workflow-foundation": "node -e \"process.env.RUN_WORKFLOW_FOUNDATION_INTEGRATION='1'; require('./scripts/workflow-foundation-integration-test')\"",
    "test:workflow-delivery": "node -e \"process.env.RUN_WORKFLOW_DELIVERY_INTEGRATION='1'; require('./scripts/workflow-notification-delivery-integration-test')\"",
    "test:foundation-rls": "node -e \"process.env.RUN_FOUNDATION_RLS_INTEGRATION='1'; require('./scripts/foundation-rls-integration-test')\"",
    "test:phase2-domains": "node -e \"process.env.RUN_PHASE2_DOMAIN_INTEGRATION='1'; require('./scripts/phase2-domain-integration-test')\"",
    "test:legacy-provenance": "node -e \"process.env.RUN_LEGACY_PROVENANCE_INTEGRATION='1'; require('./scripts/legacy-provenance-integration-test')\"",
    "test:legacy-review-groups": "node -e \"process.env.RUN_LEGACY_REVIEW_GROUPS_INTEGRATION='1'; require('./scripts/legacy-review-groups-integration-test')\"",
    "test:legacy-canonical-import": "node -e \"process.env.RUN_LEGACY_CANONICAL_IMPORT_INTEGRATION='1'; require('./scripts/legacy-canonical-import-integration-test')\"",
    "test:developer": "node -e \"process.env.RUN_DEVELOPER_INTEGRATION='1'; require('./scripts/developer-integration-test')\"",
    "test:attendance": "node -e \"process.env.RUN_ATTENDANCE_INTEGRATION='1'; require('./scripts/attendance-integration-test')\"",
    "worker:webhooks": "node scripts/webhook-worker.js",
    "worker:workflow-notifications": "node scripts/workflow-notification-worker.js",
    "test:cleanup": "node scripts/cleanup-orphan-test-events.js",
    "release:check": "node scripts/release-check.js",
    "smoke:session": "node scripts/session-smoke.js",
    "smoke:release-contract": "node -e \"process.env.RUN_PRODUCTION_RELEASE_CONTRACT_SMOKE='1'; require('./scripts/production-release-contract-smoke')\"",
    "smoke:platform-status": "node scripts/platform-status-smoke.js",
    "smoke:market-identity": "node scripts/market-identity-integration-smoke.js",
    "smoke:safety": "node scripts/safety-smoke.js",
    "smoke:work-intake": "node scripts/work-intake-smoke.js",
    "smoke:administration": "node scripts/administration-smoke.js",
    "smoke:builder": "node scripts/builder-smoke.js",
    "smoke:ai-provider": "node scripts/ai-provider-smoke.js",
    "import:legacy-employees": "node scripts/import-legacy-employees.js",
    "stage:legacy-review": "node scripts/stage-legacy-migration-review.js",
    "stage:legacy-review-groups": "node scripts/stage-legacy-review-groups.js",
    "plan:legacy-canonical-import": "node scripts/legacy-canonical-import.js",
    "import:legacy-assets": "node scripts/import-legacy-assets.js",
    "import:legacy-lighting": "node scripts/import-legacy-lighting.js",
    "import:legacy-camera-safety": "node scripts/import-legacy-camera-safety.js",
    "import:legacy-finance-inventory": "node scripts/import-legacy-finance-inventory.js",
    "repair:legacy-assets-encoding": "node scripts/repair-legacy-assets-encoding.js",
    "repair:legacy-lighting-encoding": "node scripts/repair-legacy-lighting-encoding.js",
    "repair:legacy-camera-safety-encoding": "node scripts/repair-legacy-camera-safety-encoding.js",
    "reconcile:legacy-work-flow": "node scripts/reconcile-legacy-work-order-flow.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/app.js && node --check scripts/start.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "3.10.1",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "zod": "^4.0.17"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
