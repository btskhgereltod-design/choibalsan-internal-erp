FROM node:22-alpine AS dependencies

WORKDIR /build
COPY legacy-importer/package*.json ./
RUN npm ci --omit=dev --omit=optional \
    && npm cache clean --force

FROM node:22-alpine

WORKDIR /app
COPY --from=dependencies /build/node_modules ./node_modules
COPY legacy-importer/package*.json ./
COPY scripts/legacy-canonical-import.js ./scripts/legacy-canonical-import.js
COPY src/config.js src/db.js ./src/
COPY src/services/audit.js \
    src/services/legacy-provenance.js \
    src/services/legacy-review-groups.js \
    src/services/legacy-canonical-import.js \
    ./src/services/

RUN addgroup -S importer \
    && adduser -S importer -G importer \
    && mkdir -p /app/uploads /legacy-snapshot \
    && chown -R importer:importer /app /legacy-snapshot

USER importer
ENTRYPOINT ["node", "scripts/legacy-canonical-import.js"]
