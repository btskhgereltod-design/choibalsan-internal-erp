POSTGRES_DB=erp_v2
POSTGRES_USER=erp_v2
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://erp_v2:change-this-database-password@db:5432/erp_v2
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_ISSUER=overva-development
JWT_AUDIENCE=overva-development-web
CORS_ORIGINS=http://localhost:4100
ERP_WEB_BIND_IP=127.0.0.1
API_PORT=4100
BACKUP_INTERVAL_SECONDS=86400
MONITOR_INTERVAL_SECONDS=60
WEBHOOK_WORKER_INTERVAL_MS=30000
AI_ENABLED=false
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
# Keep OPENAI_API_KEY outside Git. For Docker production use OPENAI_API_KEY_FILE.

# Optional OVERVA Connect OAuth. Keep encryption keys and client secrets outside Git.
CONNECTOR_CALLBACK_BASE_URL=http://localhost:4100
CONNECTOR_APP_URL=http://localhost:4100
# CONNECTOR_ENCRYPTION_KEY_FILE=/run/secrets/connector_encryption_key
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=/run/secrets/google_oauth_client_secret
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET_FILE=/run/secrets/github_oauth_client_secret

# Optional OVERVA Market identity recovery and Google OIDC. These remain fail-closed while disabled.
MARKET_APP_URL=http://localhost:4100
MARKET_EMAIL_ENABLED=false
# MARKET_EMAIL_ENDPOINT=https://mail-provider.example/send
# MARKET_EMAIL_FROM=no-reply@example.com
# MARKET_EMAIL_TOKEN_FILE=/run/secrets/market_email_token
MARKET_GOOGLE_OIDC_ENABLED=false
MARKET_SMS_ENABLED=false
# MARKET_SMS_ENDPOINT=https://sms-provider.example/send
# MARKET_SMS_TOKEN=
# MARKET_SMS_SENDER=OVERVA
# MARKET_PHONE_FINGERPRINT_KEY=
# MARKET_GOOGLE_OIDC_CLIENT_ID=
# MARKET_GOOGLE_OIDC_CLIENT_SECRET_FILE=/run/secrets/market_google_oidc_client_secret
# MARKET_GOOGLE_OIDC_CALLBACK_URL=http://localhost:4100/api/market/auth/google/callback

# Optional first tenant/admin. Used once when the database is empty.
BOOTSTRAP_ORG_NAME=Example Organization
BOOTSTRAP_ORG_SLUG=example-organization
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

# ERP service-owner account. This is separate from every tenant organization.
BOOTSTRAP_PLATFORM_ADMIN_NAME=Platform Administrator
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=platform@example.local
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=change-this-platform-admin-password
