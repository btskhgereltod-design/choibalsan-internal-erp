POSTGRES_DB=erp_v2
POSTGRES_USER=erp_v2
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://erp_v2:change-this-database-password@db:5432/erp_v2
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_ISSUER=overva-development
JWT_AUDIENCE=overva-development-web
CORS_ORIGINS=http://localhost:4100
ERP_WEB_BIND_IP=127.0.0.1
API_PORT=4100
BACKUP_INTERVAL_SECONDS=86400
MONITOR_INTERVAL_SECONDS=60
WEBHOOK_WORKER_INTERVAL_MS=30000
AI_ENABLED=false
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
# Keep OPENAI_API_KEY outside Git. For Docker production use OPENAI_API_KEY_FILE.

# Optional first tenant/admin. Used once when the database is empty.
BOOTSTRAP_ORG_NAME=Example Organization
BOOTSTRAP_ORG_SLUG=example-organization
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

# ERP service-owner account. This is separate from every tenant organization.
BOOTSTRAP_PLATFORM_ADMIN_NAME=Platform Administrator
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=platform@example.local
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=change-this-platform-admin-password
